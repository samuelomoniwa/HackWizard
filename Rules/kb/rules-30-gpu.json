{
  "schemaVersion": 2,
  "category": "gpu",
  "rules": [
    {
      "id": "gpu.intel.arc",
      "scope": "device",
      "group": "gpu",
      "component": "Graphics (Intel Arc dGPU)",
      "priority": 24,
      "match": {
        "category": "Gpu",
        "pciIds": [
          "8086:*"
        ],
        "devicePathRegex": "^PciRoot\\(0x[0-9a-f]+\\)/Pci\\([^)]*\\)/"
      },
      "status": "Unsupported",
      "kexts": [
        "WhateverGreen.kext"
      ],
      "deviceProperties": {
        "{device}": {
          "disable-gpu": {
            "data": "01000000"
          }
        }
      },
      "notes": [
        "Intel Arc has no macOS driver; it is disabled in macOS."
      ]
    },
    {
      "id": "gpu.amd.apu.unsupported",
      "scope": "device",
      "group": "gpu",
      "component": "Graphics (AMD iGPU)",
      "priority": 24,
      "match": {
        "category": "Gpu",
        "pciIds": [
          "1002:1681",
          "1002:15BF",
          "1002:15C8",
          "1002:1506",
          "1002:150E",
          "1002:164E",
          "1002:13C0",
          "1002:1900",
          "1002:1901",
          "1002:1114"
        ]
      },
      "status": "Unsupported",
      "notes": [
        "RDNA2/RDNA3 integrated graphics (Ryzen 6000 and newer, Raphael/Granite Ridge desktop iGPU) have no macOS driver."
      ]
    },
    {
      "id": "gpu.amd.polaris",
      "scope": "device",
      "group": "gpu",
      "component": "Graphics (AMD dGPU)",
      "priority": 25,
