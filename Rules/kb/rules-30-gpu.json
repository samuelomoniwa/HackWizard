        "gpu-dgpu"
      ],
      "notes": [
        "AMD Vega 56/64/Frontier and Radeon VII: native support."
      ]
    },
    {
      "id": "gpu.amd.navi",
      "scope": "device",
      "group": "gpu",
      "component": "Graphics (AMD dGPU)",
      "priority": 25,
      "match": {
        "category": "Gpu",
        "pciIds": [
          "1002:7310",
          "1002:7312",
          "1002:731F",
          "1002:7340",
          "1002:7341",
          "1002:73BF",
          "1002:73A5",
          "1002:73AF",
          "1002:73A2",
          "1002:73A3",
          "1002:73AB",
          "1002:73FF",
          "1002:73E3"
        ],
        "isLaptop": false
      },
      "status": "Supported",
      "kexts": [
        "WhateverGreen.kext"
      ],
      "bootArgs": [
        "agdpmod=pikera"
      ],
      "provides": [
        "gpu",
        "gpu-dgpu"
      ],
      "notes": [
        "AMD Navi 10/14/21/23 (RX 5500\u20135700, RX 6600\u20136950): native support; agdpmod=pikera fixes black screens."
      ]
    },
    {
      "id": "gpu.amd.nootedred",
      "scope": "device",
      "group": "gpu",
      "component": "Graphics (AMD iGPU)",
      "priority": 25,
      "match": {
        "category": "Gpu",
        "pciIds": [
          "1002:15DD",
          "1002:15D8",
          "1002:1636",
          "1002:1638",
          "1002:164C",
          "1002:15E7"
        ],
        "lacksCapability": [
          "gpu-dgpu"
        ]
      },
      "status": "Partial",
      "kexts": [
        "NootedRed.kext"
      ],
      "excludeKexts": [
        "WhateverGreen.kext"
      ],
      "provides": [
        "gpu"
      ],
      "notes": [
        "AMD Vega iGPU (Raven/Picasso/Renoir/Lucienne/Cezanne/Barcelo) via ChefKissInc NootedRed \u2014 experimental (occasional crashes, Chromium artefacts). Needs 512 MB+ UMA frame buffer (1 GB+ recommended). WhateverGreen must not be loaded."
      ]
    },
    {
      "id": "gpu.amd.other",
      "scope": "device",
      "group": "gpu",
      "component": "Graphics (AMD)",
      "priority": 27,
      "match": {
        "category": "Gpu",
        "pciIds": [
          "1002:*"
        ]
      },
      "status": "Unsupported",
      "kexts": [
        "WhateverGreen.kext"
      ],
      "deviceProperties": {
        "{device}": {
          "disable-gpu": {
            "data": "01000000"
          }
        }
      },
      "notes": [
        "This AMD GPU is not supported (e.g. Navi 22/24/3x, laptop Radeon, or iGPU next to a dedicated card). It is disabled in macOS."
      ]
    },
    {
      "id": "gpu.nvidia",
      "scope": "device",
      "group": "gpu",
      "component": "Graphics (NVIDIA)",
      "priority": 27,
      "match": {
        "category": "Gpu",
        "pciIds": [
          "10DE:*"
        ]
      },
      "status": "Unsupported",
      "kexts": [
        "WhateverGreen.kext"
      ],
      "deviceProperties": {
        "{device}": {
          "disable-gpu": {
            "data": "01000000"
          }
        }
      },
      "notes": [
        "NVIDIA GPUs have no driver in macOS 12 or later; the card is disabled in macOS. Laptops: Optimus GPUs are turned off, the Intel/AMD iGPU drives the screen; HDMI ports wired to the NVIDIA GPU will not work."
      ]
    },
    {
      "id": "gpu.intel.gt1",
      "scope": "device",
      "group": "gpu",
      "component": "Graphics (Intel iGPU)",
      "priority": 29,
      "match": {
        "category": "Gpu",
        "pciIds": [
          "8086:*"
        ],
        "devicePathRegex": "^(PciRoot\\(0x0\\)/Pci\\(0x2,0x0\\))?$",
        "cpuVendor": "GenuineIntel",
        "cpuNameRegex": "(Celeron|Pentium|Atom)"
      },
      "status": "Unsupported",
      "notes": [
        "Celeron/Pentium (GT1) graphics are not supported by macOS; a supported AMD GPU is required (desktops only)."
      ]
    },
