      "kexts": [
        "WhateverGreen.kext"
      ],
      "provides": [
        "gpu",
        "gpu-dgpu"
      ],
      "notes": [
        "AMD Polaris (RX 460\u2013590 / WX series): native support."
      ]
    },
    {
      "id": "gpu.amd.vega",
