      "license": "See USBToolBox/kext"
    },
    {
      "id": "iasl",
      "kind": "tool",
      "type": "raw",
      "url": "",
      "optional": true,
      "provides": [
        "iasl.exe"
      ],
      "license": "Intel ACPICA (BSD/GPL dual)",
      "notes": "Optional. Set url (and sha256) to an ACPICA Windows tools zip to cross-check the generated SSDTs. HackWizard compiles SSDTs with its own AML encoder."
