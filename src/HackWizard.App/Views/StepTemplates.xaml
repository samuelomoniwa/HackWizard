<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:HackWizard.App.ViewModels"
                    xmlns:conv="clr-namespace:HackWizard.App.Converters"
                    xmlns:usb="clr-namespace:HackWizard.Core.Usb;assembly=HackWizard.Core">

    <conv:StatusBrushConverter x:Key="StatusBrush"/>
    <conv:StatusGlyphConverter x:Key="StatusGlyph"/>
    <conv:NonEmptyToVisibilityConverter x:Key="NonEmpty"/>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <DataTemplate DataType="{x:Type vm:PreflightViewModel}">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <ItemsControl ItemsSource="{Binding Checks}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusGlyph}}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Detail}"/>
                                    <TextBlock Text="{Binding Fix}" Foreground="{DynamicResource Brush.Warn}" Visibility="{Binding Fix, Converter={StaticResource NonEmpty}}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Button Content="_Re-run checks" Command="{Binding RunCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
            <TextBlock Text="Legal notice" Style="{StaticResource H2}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding LegalNotice}"/>
                    <CheckBox Margin="0,10,0,0" IsChecked="{Binding LegalAccepted}" Content="I have read this, backed up my data, and accept full responsibility." AutomationProperties.Name="Accept legal notice"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HardwareViewModel}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="_Detect again" Command="{Binding DetectCommand}"/>
                <Button Content="Open HTML _report" Command="{Binding OpenReportCommand}"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Rows}" MaxHeight="520">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Details (IDs, ACPI path, OpenCore path)" Binding="{Binding Detail}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CompatibilityViewModel}">
        <StackPanel>
            <Border Style="{StaticResource Danger}" Visibility="{Binding IsBlocked, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding BlockingText}" Foreground="{DynamicResource Brush.Bad}" FontWeight="SemiBold"/>
            </Border>
            <Border Style="{StaticResource WarnBox}" Visibility="{Binding WarningsText, Converter={StaticResource NonEmpty}}">
                <TextBlock Text="{Binding WarningsText}"/>
            </Border>
            <DataGrid ItemsSource="{Binding Items}" MaxHeight="430">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Status" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusGlyph}}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" FontWeight="Bold" Margin="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="170"/>
                    <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="2*"/>
                    <DataGridTemplateColumn Header="What this means" Width="3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="4,2"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding SmbiosText}" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <TextBlock Text="macOS version" Style="{StaticResource H2}"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding MacosVersions}" SelectedItem="{Binding SelectedMacos}" DisplayMemberPath="Name" AutomationProperties.Name="macOS version"/>
                <Button Content="Check for _knowledge-base update" Command="{Binding UpdateKbCommand}" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding KbVersion}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}"/>
            </StackPanel>
            <TextBlock Text="{Binding MacosWarning}" Foreground="{DynamicResource Brush.Warn}" Margin="0,8,0,0"/>
            <TextBlock Text="Processor name shown in About This Mac" Style="{StaticResource H2}"/>
            <RadioButton GroupName="cpuname" IsChecked="{Binding ShowRealCpu}" Content="{Binding RealCpuLabel}" Margin="0,0,0,4"/>
            <RadioButton GroupName="cpuname" IsChecked="{Binding ShowMacCpu}" Content="{Binding MacCpuLabel}"/>
            <TextBlock Text="Cosmetic only (via RestrictEvents): the real core count, speed and CPU features are unchanged, and apps still see your real processor."
                       Foreground="{DynamicResource Brush.Muted}" Margin="0,4,0,0"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AcpiViewModel}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="_Regenerate" Command="{Binding RunCommand}"/>
                <Button Content="Open _ACPI dump folder" Command="{Binding OpenDumpCommand}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Notes}" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Ssdts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Explanation}" Margin="0,2,0,6"/>
                                <Expander Header="Show source (.dsl)" Foreground="{DynamicResource Brush.Foreground}">
                                    <TextBox Text="{Binding Dsl, Mode=OneWay}" Style="{StaticResource Mono}" MaxHeight="260"/>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:UsbMapViewModel}">
        <StackPanel>
            <Border Style="{StaticResource Card}"><TextBlock Text="{Binding Instructions}"/></Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="{Binding DiscoverButtonText}" Command="{Binding ToggleDiscoveryCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="_Auto-select used ports" Command="{Binding AutoSelectCommand}"/>
                <Button Content="Select _none (skip mapping)" Command="{Binding ClearCommand}"/>
                <Button Content="_Forget and rescan" Command="{Binding ResetCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Controllers}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Header}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,6"/>
                                <DataGrid ItemsSource="{Binding Ports}" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="460">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Use">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Port" Binding="{Binding Name}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding ProtocolText}" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="Connector">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox MinWidth="200" ItemsSource="{x:Static usb:UsbConnectors.All}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                                              SelectedValue="{Binding Connector, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Pair" Binding="{Binding CompanionText}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Now" Binding="{Binding LiveText}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Last device seen" Binding="{Binding LastDevice}" IsReadOnly="True" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="_Start downloads" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"/>
                <CheckBox Content="Use cached files (offline mode)" IsChecked="{Binding Offline}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold"/>
                            <ProgressBar Grid.Column="1" Value="{Binding Percent, Mode=OneWay}" Height="14" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Status}"/>
                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Brush.Muted}" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:EfiViewModel}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Re_build" Command="{Binding BuildCommand}"/>
                <Button Content="Open _staging folder" Command="{Binding OpenFolderCommand}"/>
                <Button Content="Check serial on _Apple coverage page" Command="{Binding CheckCoverageCommand}"/>
            </StackPanel>
            <Border Style="{StaticResource Card}"><TextBlock Text="{Binding Identity}"/></Border>
            <ItemsControl ItemsSource="{Binding Notes}"/>
            <TextBlock Text="ocvalidate" Style="{StaticResource H2}"/>
            <TextBox Text="{Binding Validation, Mode=OneWay}" Style="{StaticResource Mono}" Height="120"/>
            <TextBlock Text="Kext load order" Style="{StaticResource H2}"/>
            <ListBox ItemsSource="{Binding KextOrder}" MaxHeight="200" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
            <Expander Header="Changes compared with OpenCore's Sample.plist" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Foreground}">
                <TextBox Text="{Binding Diff, Mode=OneWay}" Style="{StaticResource Mono}" Height="300"/>
            </Expander>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:UsbViewModel}">
        <StackPanel>
            <Button Content="_Refresh drives" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" DisplayMemberPath="Display" MinHeight="70" AutomationProperties.Name="USB drives"/>
            <TextBlock Text="Mode" Style="{StaticResource H2}"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Dry run (write nothing)" IsChecked="{Binding DryRun}" GroupName="mode"/>
                <RadioButton Content="Simulate on image file" IsChecked="{Binding Simulate}" GroupName="mode"/>
                <RadioButton Content="Write to USB drive (ERASES IT)" IsChecked="{Binding RealWrite}" GroupName="mode" Foreground="{DynamicResource Brush.Bad}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding Simulate, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Image file:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding ImagePath}" Width="520"/>
            </StackPanel>
            <Border Style="{StaticResource Danger}" Margin="0,10,0,10" Visibility="{Binding RealWrite, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="To confirm, type the disk number of the selected USB drive:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding ConfirmNumber, UpdateSourceTrigger=PropertyChanged}" Width="60" AutomationProperties.Name="Confirm disk number"/>
                </StackPanel>
            </Border>
            <Button Content="_Go" Command="{Binding WriteCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,8"/>
            <TextBox Text="{Binding Log, Mode=OneWay}" Style="{StaticResource Mono}" Height="220"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:BiosViewModel}">
        <StackPanel>
            <Border Style="{StaticResource Card}"><TextBlock Text="{Binding Header}"/></Border>
            <Button Content="Open printable _guide" Command="{Binding OpenHtmlCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
            <ItemsControl ItemsSource="{Binding Settings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock FontWeight="Bold"><Run Text="{Binding Title, Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding Value, Mode=OneWay}"/></TextBlock>
                                <TextBlock Text="{Binding MenuPath}" Foreground="{DynamicResource Brush.Accent}"/>
                                <TextBlock Text="{Binding Why}" Margin="0,4,0,0"/>
                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.Muted}" Visibility="{Binding IfMissing, Converter={StaticResource NonEmpty}}">
                                    <Run Text="If you don't see it: " FontStyle="Italic"/><Run Text="{Binding IfMissing, Mode=OneWay}"/>
                                </TextBlock>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="10" Margin="0,6,0,0">
                                    <TextBlock Text="[Screenshot / diagram placeholder]" Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Header="Advanced: apply ThinkPad settings automatically (Lenovo WMI)" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Foreground}"
                      Visibility="{Binding LenovoAvailable, Converter={StaticResource BoolVis}}">
                <StackPanel Margin="0,8,0,0">
                    <CheckBox IsChecked="{Binding LenovoOptIn}" Content="I want HackWizard to read and (after confirmation) change BIOS settings via Lenovo WMI."/>
                    <Button Content="Read current _values" Command="{Binding ReadLenovoCommand}" HorizontalAlignment="Left" Margin="0,8,0,8"/>
                    <DataGrid ItemsSource="{Binding Changes}" IsReadOnly="False" MaxHeight="260" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Apply" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Setting" Binding="{Binding Title}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="WMI name" Binding="{Binding WmiName}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Current (before)" Binding="{Binding Current}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="New (after)" Binding="{Binding Target}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Supervisor password (only if set):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <PasswordBox x:Name="SupervisorPwd" Width="200"/>
                        <Button Content="_Apply selected" Command="{Binding ApplyLenovoCommand}" CommandParameter="{Binding ElementName=SupervisorPwd}" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBox Text="{Binding LenovoLog, Mode=OneWay}" Style="{StaticResource Mono}" Height="100" Margin="0,8,0,0"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FinalViewModel}">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <ItemsControl ItemsSource="{Binding Checklist}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" Margin="0,4" FontSize="15"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Button Content="Restart into _BIOS now" Command="{Binding RestartToBiosCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
